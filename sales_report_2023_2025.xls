<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Author>Antigravity AI</Author>
  <Title>Executive Sales Performance Report</Title>
  <Created>2026-10-22T00:00:00Z</Created>
 </DocumentProperties>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#334155"/>
  </Style>
  <Style ss:ID="Title">
   <Font ss:FontName="Segoe UI" ss:Size="16" ss:Bold="1" ss:Color="#0F172A"/>
  </Style>
  <Style ss:ID="Subtitle">
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Italic="1" ss:Color="#64748B"/>
  </Style>
  <Style ss:ID="HeaderIndigo">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#4F46E5" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="HeaderSlate">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#334155" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="KpiLabel">
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#475569"/>
   <Interior ss:Color="#F8FAFC" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="KpiValCurrency">
   <Alignment ss:Horizontal="Right"/>
   <Font ss:FontName="Segoe UI" ss:Size="11" ss:Bold="1" ss:Color="#0F172A"/>
   <Interior ss:Color="#F8FAFC" ss:Pattern="Solid"/>
   <NumberFormat ss:Format="&quot;$&quot;#,##0.00"/>
   <Borders>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="KpiValInt">
   <Alignment ss:Horizontal="Right"/>
   <Font ss:FontName="Segoe UI" ss:Size="11" ss:Bold="1" ss:Color="#0F172A"/>
   <Interior ss:Color="#F8FAFC" ss:Pattern="Solid"/>
   <NumberFormat ss:Format="#,##0"/>
   <Borders>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="KpiValPct">
   <Alignment ss:Horizontal="Right"/>
   <Font ss:FontName="Segoe UI" ss:Size="11" ss:Bold="1" ss:Color="#0F172A"/>
   <Interior ss:Color="#F8FAFC" ss:Pattern="Solid"/>
   <NumberFormat ss:Format="0.0%"/>
   <Borders>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="Currency">
   <Alignment ss:Horizontal="Right"/>
   <NumberFormat ss:Format="&quot;$&quot;#,##0.00"/>
  </Style>
  <Style ss:ID="Percent">
   <Alignment ss:Horizontal="Right"/>
   <NumberFormat ss:Format="0.0%"/>
  </Style>
  <Style ss:ID="Integer">
   <Alignment ss:Horizontal="Right"/>
   <NumberFormat ss:Format="#,##0"/>
  </Style>
  <Style ss:ID="Date">
   <Alignment ss:Horizontal="Center"/>
   <NumberFormat ss:Format="yyyy-mm-dd"/>
  </Style>
  <Style ss:ID="Center">
   <Alignment ss:Horizontal="Center"/>
  </Style>
  <Style ss:ID="TotalRow">
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#0F172A"/>
   <Interior ss:Color="#EEF2FF" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#6366F1"/>
    <Border ss:Position="Bottom" ss:LineStyle="Double" ss:Weight="3" ss:Color="#6366F1"/>
   </Borders>
  </Style>
  <Style ss:ID="TotalCurrency">
   <Alignment ss:Horizontal="Right"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#0F172A"/>
   <Interior ss:Color="#EEF2FF" ss:Pattern="Solid"/>
   <NumberFormat ss:Format="&quot;$&quot;#,##0.00"/>
   <Borders>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#6366F1"/>
    <Border ss:Position="Bottom" ss:LineStyle="Double" ss:Weight="3" ss:Color="#6366F1"/>
   </Borders>
  </Style>
 </Styles>

 <!-- SHEET 1: RINGKASAN EKSEKUTIF -->
 <Worksheet ss:Name="Ringkasan Eksekutif">
  <Table ss:DefaultRowHeight="18">
   <Column ss:Width="200"/>
   <Column ss:Width="160"/>
   <Column ss:Width="40"/>
   <Column ss:Width="200"/>
   <Column ss:Width="160"/>

   <Row ss:Height="26">
    <Cell ss:MergeAcross="4" ss:StyleID="Title"><Data ss:Type="String">LAPORAN KINERJA PENJUALAN EKSEKUTIF (2023 - 2025)</Data></Cell>
   </Row>
   <Row ss:Height="18">
    <Cell ss:MergeAcross="4" ss:StyleID="Subtitle"><Data ss:Type="String">Analisis Komprehensif Berdasarkan 500 Transaksi Penjualan Produk &amp; Profitabilitas</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>

   <!-- KPI Cards Row 1 -->
   <Row ss:Height="22">
    <Cell ss:StyleID="KpiLabel"><Data ss:Type="String">Total Nilai Penjualan (Revenue)</Data></Cell>
    <Cell ss:StyleID="KpiValCurrency" ss:Formula="=SUM('Data Transaksi'!W2:W501)"><Data ss:Type="Number">0</Data></Cell>
    <Cell></Cell>
    <Cell ss:StyleID="KpiLabel"><Data ss:Type="String">Total Volume Transaksi (Orders)</Data></Cell>
    <Cell ss:StyleID="KpiValInt" ss:Formula="=COUNTA('Data Transaksi'!A2:A501)"><Data ss:Type="Number">500</Data></Cell>
   </Row>

   <!-- KPI Cards Row 2 -->
   <Row ss:Height="22">
    <Cell ss:StyleID="KpiLabel"><Data ss:Type="String">Total Keuntungan Bersih (Profit)</Data></Cell>
    <Cell ss:StyleID="KpiValCurrency" ss:Formula="=SUM('Data Transaksi'!X2:X501)"><Data ss:Type="Number">0</Data></Cell>
    <Cell></Cell>
    <Cell ss:StyleID="KpiLabel"><Data ss:Type="String">Total Kuantitas Barang (Units Sold)</Data></Cell>
    <Cell ss:StyleID="KpiValInt" ss:Formula="=SUM('Data Transaksi'!S2:S501)"><Data ss:Type="Number">0</Data></Cell>
   </Row>

   <!-- KPI Cards Row 3 -->
   <Row ss:Height="22">
    <Cell ss:StyleID="KpiLabel"><Data ss:Type="String">Rata-rata Margin Keuntungan %</Data></Cell>
    <Cell ss:StyleID="KpiValPct" ss:Formula="=R[-1]C/R[-2]C"><Data ss:Type="Number">0</Data></Cell>
    <Cell></Cell>
    <Cell ss:StyleID="KpiLabel"><Data ss:Type="String">Rata-rata Nilai Order (AOV)</Data></Cell>
    <Cell ss:StyleID="KpiValCurrency" ss:Formula="=R[-2]C[-3]/R[-2]C"><Data ss:Type="Number">0</Data></Cell>
   </Row>

   <!-- KPI Cards Row 4 -->
   <Row ss:Height="22">
    <Cell ss:StyleID="KpiLabel"><Data ss:Type="String">Total Biaya Pokok (Cost Price)</Data></Cell>
    <Cell ss:StyleID="KpiValCurrency" ss:Formula="=R[-3]C-R[-2]C"><Data ss:Type="Number">0</Data></Cell>
    <Cell></Cell>
    <Cell ss:StyleID="KpiLabel"><Data ss:Type="String">Total Transaksi Retur</Data></Cell>
    <Cell ss:StyleID="KpiValInt" ss:Formula="=COUNTIF('Data Transaksi'!AE2:AE501,&quot;Yes&quot;)"><Data ss:Type="Number">0</Data></Cell>
   </Row>

   <Row ss:Height="15"></Row>

   <!-- Section: Status Order Breakdown -->
   <Row ss:Height="20">
    <Cell ss:MergeAcross="4" ss:StyleID="HeaderSlate"><Data ss:Type="String">STATUS FULFILLMENT PESANAN</Data></Cell>
   </Row>
   <Row ss:Height="18">
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Status Pesanan</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Jumlah Transaksi</Data></Cell>
    <Cell></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Metode Pengiriman</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Jumlah Transaksi</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Completed</Data></Cell>
    <Cell ss:StyleID="Integer" ss:Formula="=COUNTIF('Data Transaksi'!AB2:AB501,&quot;Completed&quot;)"><Data ss:Type="Number">0</Data></Cell>
    <Cell></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Express</Data></Cell>
    <Cell ss:StyleID="Integer" ss:Formula="=COUNTIF('Data Transaksi'!AD2:AD501,&quot;Express&quot;)"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Shipped</Data></Cell>
    <Cell ss:StyleID="Integer" ss:Formula="=COUNTIF('Data Transaksi'!AB2:AB501,&quot;Shipped&quot;)"><Data ss:Type="Number">0</Data></Cell>
    <Cell></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Standard</Data></Cell>
    <Cell ss:StyleID="Integer" ss:Formula="=COUNTIF('Data Transaksi'!AD2:AD501,&quot;Standard&quot;)"><Data ss:Type="Number">0</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Pending</Data></Cell>
    <Cell ss:StyleID="Integer" ss:Formula="=COUNTIF('Data Transaksi'!AB2:AB501,&quot;Pending&quot;)"><Data ss:Type="Number">0</Data></Cell>
    <Cell></Cell>
    <Cell></Cell>
    <Cell></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- SHEET 2: KATEGORI & BRAND -->
 <Worksheet ss:Name="Kategori &amp; Brand">
  <Table ss:DefaultRowHeight="18">
   <Column ss:Width="140"/>
   <Column ss:Width="110"/>
   <Column ss:Width="130"/>
   <Column ss:Width="130"/>
   <Column ss:Width="100"/>
   
   <Row ss:Height="24">
    <Cell ss:MergeAcross="4" ss:StyleID="Title"><Data ss:Type="String">RINGKASAN PENJUALAN PER KATEGORI &amp; BRAND</Data></Cell>
   </Row>
   <Row ss:Height="12"></Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Kategori Produk</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Brand Terkait</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Sub-Kategori</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Format Produk Utama</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Performa Kategori</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Electronics</Data></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Apple, Dell, HP</Data></Cell>
    <Cell><Data ss:Type="String">Laptop, Monitor</Data></Cell>
    <Cell><Data ss:Type="String">High Ticket Items</Data></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Sangat Tinggi</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Furniture</Data></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Apple, Dell, HP</Data></Cell>
    <Cell><Data ss:Type="String">Desk</Data></Cell>
    <Cell><Data ss:Type="String">Office Setup</Data></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Tinggi</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Appliances</Data></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Apple, Dell, HP</Data></Cell>
    <Cell><Data ss:Type="String">Blender</Data></Cell>
    <Cell><Data ss:Type="String">Smart Appliances</Data></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Menengah</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Stationery</Data></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Apple, Dell, HP</Data></Cell>
    <Cell><Data ss:Type="String">Notebook</Data></Cell>
    <Cell><Data ss:Type="String">Digital / Paper Notes</Data></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Menengah</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Accessories</Data></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Apple, Dell, HP</Data></Cell>
    <Cell><Data ss:Type="String">Mouse</Data></Cell>
    <Cell><Data ss:Type="String">Peripherals</Data></Cell>
    <Cell ss:StyleID="Center"><Data ss:Type="String">Volume Tinggi</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- SHEET 3: DATA TRANSAKSI -->
 <Worksheet ss:Name="Data Transaksi">
  <Table ss:DefaultRowHeight="17">
   <Column ss:Width="90"/>  <!-- Order ID -->
   <Column ss:Width="85"/>  <!-- Order Date -->
   <Column ss:Width="45"/>  <!-- Year -->
   <Column ss:Width="50"/>  <!-- Quarter -->
   <Column ss:Width="70"/>  <!-- Month -->
   <Column ss:Width="55"/>  <!-- Month No -->
   <Column ss:Width="65"/>  <!-- Month-Year -->
   <Column ss:Width="85"/>  <!-- Customer ID -->
   <Column ss:Width="90"/>  <!-- Customer Name -->
   <Column ss:Width="75"/>  <!-- Product ID -->
   <Column ss:Width="110"/> <!-- Product Name -->
   <Column ss:Width="90"/>  <!-- Category -->
   <Column ss:Width="85"/>  <!-- Sub Category -->
   <Column ss:Width="65"/>  <!-- Brand -->
   <Column ss:Width="65"/>  <!-- Region -->
   <Column ss:Width="85"/>  <!-- State -->
   <Column ss:Width="95"/>  <!-- City -->
   <Column ss:Width="90"/>  <!-- Sales Person -->
   <Column ss:Width="45"/>  <!-- Quantity -->
   <Column ss:Width="80"/>  <!-- Unit Price -->
   <Column ss:Width="70"/>  <!-- Discount % -->
   <Column ss:Width="80"/>  <!-- Cost Price -->
   <Column ss:Width="85"/>  <!-- Sales -->
   <Column ss:Width="80"/>  <!-- Profit -->
   <Column ss:Width="85"/>  <!-- Profit Margin % -->
   <Column ss:Width="80"/>  <!-- Gross Profit -->
   <Column ss:Width="80"/>  <!-- Net Profit -->
   <Column ss:Width="85"/>  <!-- Order Status -->
   <Column ss:Width="85"/>  <!-- Payment Mode -->
   <Column ss:Width="80"/>  <!-- Ship Mode -->
   <Column ss:Width="75"/>  <!-- Return Status -->

   <!-- Header Row -->
   <Row ss:Height="22">
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Order ID</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Order Date</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Year</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Quarter</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Month</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Month No</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Month-Year</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Customer ID</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Customer Name</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Product ID</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Product Name</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Category</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Sub Category</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Brand</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Region</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">State</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">City</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Sales Person</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Quantity</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Unit Price</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Discount %</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Cost Price</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Sales</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Profit</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Profit Margin %</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Gross Profit</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Net Profit</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Order Status</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Payment Mode</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Ship Mode</Data></Cell>
    <Cell ss:StyleID="HeaderIndigo"><Data ss:Type="String">Return Status</Data></Cell>
   </Row>
